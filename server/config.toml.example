app_title = "APK SDK Local Compatibility Server"

[http]
host = "0.0.0.0"
port = 8080

[sdk]
local_base_url = "http://127.0.0.1:8080"
domain_urls = []
site_url = ""
pay_url = ""
game_track_url = ""
upload_image_url = ""
media_url = ""
auto_credit_g_points = true

[game]
tcp_host = "0.0.0.0"
tcp_port = 21001
advertise_host = "127.0.0.1"
server_id = 4
server_name = "桃花烂漫"
user_name = ""
user_level = 0
server_type = 3
status = 1
close_register = false
is_whitelist = 0
resource_url = "/ReleaseGame18/Android/1.2.5"
resource_env_type = "prod"
notify_url = "http://127.0.0.1:8080/local/notify-disabled"
fixture_dir = "server/data/fixtures"
startup_template = ""  # 可选：静态 legacy 启动模板；留空时使用 fixture_dir + init_capture
init_capture = "server/data/captures/tao-original-20260823-1605-game-frames.json"
gameplay_capture = "server/data/captures/tao-continuous-20260823-174438-game-frames.json"
poll_interval = 0.2
trace = false

[storage]
database = "server/data/server.sqlite3"
token_ttl_seconds = 2592000

[logging]
data_dir = "server/data"
level = "INFO"
server_log = "server.log"
game_tcp_log = "game_tcp.log"
console = true
